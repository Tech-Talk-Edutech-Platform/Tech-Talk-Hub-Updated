# Normalise line endings to LF for everyone (Windows, macOS, Linux)
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfile: don't show diffs, treat as generated
bun.lock linguist-generated=true -diff
