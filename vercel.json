{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "trailingSlash": false,
      "functions": {
        "api/render.mjs": {
          "includeFiles": "{dist/app.html,dist-ssr/**}"
        }
      },
      "rewrites": [
        {
          "source": "/:dashboard(tutor|owner|operations_admin|tech_admin|student|marketer|assign-homework|receive-homework|calendar|receipt|upload-results|users|_dashboard-session)",
          "destination": "/api/render?__dashboard_path=/:dashboard"
        },
        {
          "source": "/:page(about|blog|book|booking-failed|booking-success|careers|cart|checkout|child-safety|contact|curriculum|donate|faculty|favorites|future-developers|junior-coders|login|pricing|privacy|shop|tech-professionals|terms)",
          "destination": "/:page.html"
        },
        {
          "source": "/:section(blog|courses|shop)/:slug",
          "destination": "/:section/:slug.html"
        },
        { "source": "/(.*)", "destination": "/app.html" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.ts"
    },
    "studio": {
      "root": "studio",
      "framework": "sanity",
      "buildCommand": "SANITY_STUDIO_BASE_PATH=/studio sanity build dist/studio -y",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/studio", "destination": "/studio/index.html" },
        { "source": "/studio/(.*)", "destination": "/studio/index.html" }
      ]
    }
  },
  "redirects": [
    { "source": "/book-class", "destination": "/book", "permanent": true },
    { "source": "/courses", "destination": "/curriculum", "permanent": true },
    { "source": "/programs", "destination": "/curriculum", "permanent": true },
    {
      "source": "/learning-paths",
      "destination": "/curriculum",
      "permanent": true
    },
    { "source": "/contact-us", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/receipt/:reference", "destination": { "service": "server" } },
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/studio", "destination": { "service": "studio" } },
    { "source": "/studio/(.*)", "destination": { "service": "studio" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
