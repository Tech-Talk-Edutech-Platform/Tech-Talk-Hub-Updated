{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build:vercel",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [{ "source": "/(.*)", "destination": "/app.html" }]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.ts"
    },
    "studio": {
      "root": "studio",
      "framework": "sanity",
      "buildCommand": "SANITY_STUDIO_BASE_PATH=/studio sanity build dist/studio -y",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/studio", "destination": "/studio/index.html" },
        { "source": "/studio/(.*)", "destination": "/studio/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/studio", "destination": { "service": "studio" } },
    { "source": "/studio/(.*)", "destination": { "service": "studio" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
