  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "^2.75.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "scripts": {
    "start": "vite",
    "prestart": "npm run build:worker",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:ci": "oxlint --deny-warnings . --format=github",
    "check:ci": "npm run format:check && npm run lint:ci && npm run typecheck",
    "build": "npm run check:ci && npm run build:worker && vite build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "test": "react-scripts test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && npm --prefix server run typecheck",
    "dev": "npm run build:worker && vite",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "gen:types": "supabase gen types typescript --project-id iinwzibplknjqmofevpw --schema public > src/types/database.ts && prettier --write src/types/database.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
