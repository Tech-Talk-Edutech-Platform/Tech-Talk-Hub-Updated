# Browser-safe Supabase project credentials. Use a project-specific local value.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API server origin, set per mode:
#   .env.development  VITE_BACKEND_SERVER_URL=http://localhost:5000  (Vite proxies /api here)
#   .env.production   VITE_BACKEND_SERVER_URL=https://tech-talk-hub-updated-server.vercel.app
# Dev defaults to http://localhost:5000 when unset. In a production build,
# leaving it empty calls /api on the site's own origin.
VITE_BACKEND_SERVER_URL=
