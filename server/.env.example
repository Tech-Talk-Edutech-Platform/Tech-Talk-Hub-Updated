# Server-only credentials. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
AT_USERNAME=
AT_API_KEY=
RESEND_API_KEY=
APP_BASE_URL=http://localhost:3000

# Curriculum roadmap emails (POST /api/send-curriculum).
CURRICULUM_PDF_URL=
# Optional: verified Resend sender; defaults to "Tech Talk Hub <admin@techtalk-hub.com>".
CURRICULUM_FROM_EMAIL=
# Optional: where "New Lead: Curriculum Download" notifications go.
LEAD_NOTIFICATION_EMAIL=

# Optional: extra comma-separated origins allowed to call this API cross-origin
# (e.g. a preview deploy). The site's own origins (www/apex techtalk-hub.com,
# tech-talk-hub-updated.vercel.app, localhost) are built into middleware/cors.ts.
CORS_ORIGINS=
# Optional: number of reverse proxies in front of this server (for client IPs).
TRUST_PROXY=

# LiveKit Cloud or self-hosted media server. Keep the API secret server-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SMS reminders and trial-email retries on Vercel: whatever calls GET/POST
# /api/cron/reminders every minute must send "Authorization: Bearer
# <CRON_SECRET>". Vercel Cron sends it automatically when CRON_SECRET is set on
# the project. Not needed locally, where node-cron runs inside the server.
CRON_SECRET=

# Email over SMTP (nodemailer): trial class invites with the classroom link.
# Real values go in server/.env (gitignored) and the Vercel server project's
# env, never in this file. Until they're set the server runs normally and
# trial emails wait; they go out once the keys are added.
#
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste its 16 letters (spaces
# are fine) as SMTP_PASS. Your normal Gmail password won't work.
SMTP_HOST=smtp.gmail.com
# 587 (STARTTLS) or 465 (TLS). SMTP_SECURE defaults to true on 465.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional: the sender families see. A bare name ("Tech Talk Hub") is sent
# from SMTP_USER. Gmail only allows SMTP_USER or a verified "Send mail as"
# alias as the address.
MAIL_FROM="Tech Talk Hub <you@gmail.com>"
# Optional: where parents' replies go.
MAIL_REPLY_TO=
# Optional: the site families open from the email; defaults to
# https://www.techtalk-hub.com. Set http://localhost:5173 to test locally.
PUBLIC_SITE_URL=
