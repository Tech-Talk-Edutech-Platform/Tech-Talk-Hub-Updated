# Server-only credentials. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
AT_USERNAME=
AT_API_KEY=
RESEND_API_KEY=
APP_BASE_URL=http://localhost:3000

# Curriculum roadmap emails (POST /api/send-curriculum).
CURRICULUM_PDF_URL=
# Optional: verified Resend sender; defaults to "Tech Talk Hub <admin@techtalk-hub.com>".
CURRICULUM_FROM_EMAIL=
# Optional: where "New Lead: Curriculum Download" notifications go.
LEAD_NOTIFICATION_EMAIL=

# Optional: comma-separated site origins allowed to call this API cross-origin,
# e.g. https://techtalk-hub.com. Leave empty when /api is proxied same-origin.
CORS_ORIGINS=
# Optional: number of reverse proxies in front of this server (for client IPs).
TRUST_PROXY=
